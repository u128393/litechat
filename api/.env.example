# Database
DATABASE_URL=sqlite://data/litechat.db?mode=rwc
# DATABASE_URL=postgres://litechat:litechat@127.0.0.1:5432/litechat
# DATABASE_URL=mysql://litechat:litechat@127.0.0.1:3306/litechat

# Auth and session
AUTH_SESSION_SECRET=local-dev-session-secret-change-me-123456
AUTH_SESSION_COOKIE_NAME=litechat_session
AUTH_SESSION_TTL_HOURS=720

# Shared provider-key encryption secret used before provider settings are persisted.
PROVIDER_KEY_ENCRYPTION_SECRET=local-dev-provider-secret-change-me-123456

# API bind address
APP_HOST=127.0.0.1
APP_PORT=8787

# Optional file upload storage. Upload UI is hidden unless these values are set.
# STORAGE_BUCKET=litechat-files
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_BASE_URL=https://files.example.com
# STORAGE_ENDPOINT=https://example.r2.cloudflarestorage.com
# STORAGE_FORCE_PATH_STYLE=true
# STORAGE_MAX_FILE_SIZE_BYTES=52428800
