# Database
DATABASE_URL=sqlite://data/litechat.db?mode=rwc
# DATABASE_URL=postgres://litechat:litechat@127.0.0.1:5432/litechat
# DATABASE_URL=mysql://litechat:litechat@127.0.0.1:3306/litechat

# Auth and session
AUTH_SESSION_SECRET=local-dev-session-secret-change-me-123456
AUTH_SESSION_COOKIE_NAME=litechat_session
AUTH_SESSION_TTL_HOURS=720

# Shared provider-key encryption secret used before provider settings are persisted.
PROVIDER_KEY_ENCRYPTION_SECRET=local-dev-provider-secret-change-me-123456

# API bind address
APP_HOST=127.0.0.1
APP_PORT=8787

# Optional file upload storage. Upload UI is hidden unless one backend is configured.
# Configure either STORAGE_S3_* or STORAGE_OSS_*, not both.

# S3-compatible storage, including S3, R2, and MinIO.
# STORAGE_S3_BUCKET=litechat-files
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_PUBLIC_BASE_URL=https://files.example.com
# STORAGE_S3_UPLOAD_PATH=dev/uploads
# STORAGE_S3_GENERATED_PATH=dev/generated
# STORAGE_S3_ENDPOINT=https://example.r2.cloudflarestorage.com
# STORAGE_S3_FORCE_PATH_STYLE=true
# STORAGE_S3_MAX_FILE_SIZE_BYTES=52428800

# Aliyun OSS storage.
# STORAGE_OSS_ENDPOINT=https://litechat-files.oss-cn-hangzhou.aliyuncs.com
# STORAGE_OSS_ACCESS_KEY_ID=
# STORAGE_OSS_ACCESS_KEY_SECRET=
# STORAGE_OSS_PUBLIC_ENDPOINT=https://files.example.com
# STORAGE_OSS_UPLOAD_PATH=dev/uploads
# STORAGE_OSS_GENERATED_PATH=dev/generated
# STORAGE_OSS_MAX_FILE_SIZE_BYTES=52428800
